# Used by tools/sync-public-knowledge.sh — one rsync(1) exclude pattern per line.
# Lines starting with # are ignored by rsync.

# Repo internals — not part of the public library
.git/
.vscode/
tools/
templates/
README.md
GUIDE_ORGANIZATION.md
run.sh

# LaTeX sources and intermediates — only the built .pdf/.html are public
*.tex
*.aux
*.log
*.toc
*.fls
*.fdb_latexmk
*.out
